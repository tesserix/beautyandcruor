node_modules/
.DS_Store
.next/
out/

# Reference capture — large, regenerable from the live site while it exists.
# Keep manifests and parsed data (they are the durable record); ignore the bulk.
capture/assets/uploads/
# Full-resolution originals deduplicated from the public_html bundle (502 MB).
# This is the pipeline's real source — see scripts/images.mjs.
capture/assets/originals/
capture/screens/
capture/contactsheets/*.jpg
capture/audit/*.png
capture/*.html
capture/meta/home.html

# Generated image derivatives — rebuilt by `npm run images`.
# public/img stays out: the derivatives live in GCS and the container never
# carries them.
public/img/

# src/generated/images.json is COMMITTED on purpose — see below.
# It is the only thing a build needs: public/img is in .dockerignore, so CI
# builds the site from the manifest alone and never touches an image file.
# Leaving it generated-only meant a clean clone could not build at all, and
# the Dockerfile's "fetch originals from object storage" path does not exist
# (that bucket was deliberately deleted). Regenerate with `npm run images`
# on a machine that has capture/assets/originals, then commit the diff.

# Prototype bundles — rebuilt from design/sources by build-imm.mjs
capture/proto-images.json

# Next.js / TS build artefacts
tsconfig.tsbuildinfo
next-env.d.ts

# The sidecar binary, if built in place.
/enquiry/enquiry

# A --sample run derives a dozen images to eyeball encoder settings.
src/generated/images.sample.json
